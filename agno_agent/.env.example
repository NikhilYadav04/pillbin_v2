NODE_JS_BASE_URL=http://localhost:5000/api
CORS_ORIGINS=*

LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_ROUTER_MODEL=gemini-2.0-flash-lite
GEMINI_AGENT_MODEL=gemini-2.5-flash

# Only needed when LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_ROUTER_MODEL=llama-3.1-8b-instant
GROQ_AGENT_MODEL=llama-3.3-70b-versatile

REDIS_URL=redis://localhost:6379
SQLITE_PATH=tmp/pillbin.db
CHROMA_PATH=tmp/chromadb
CHROMA_COLLECTION=pillbin_docs

# Optional: Jev intent router, falls back to the LLM router while disabled
JEV_ENABLED=false
JEV_API_KEY=
JEV_BASE_URL=https://ai-gateway.vercel.sh
JEV_MODEL=typesafe-ai/jev
JEV_TIMEOUT=2
