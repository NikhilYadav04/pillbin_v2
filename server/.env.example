PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/pillbin

JWT_SECRET=change_me_to_a_random_string_of_32_chars_or_more
JWT_REFRESH_SECRET=change_me_to_a_different_random_string
JWT_EXPIRES_IN=3h

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
RESEND_API_KEY=

GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: push notifications are disabled when these are empty
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional: AI cover images for blog posts (Azure FLUX)
AZURE_FLUX_ENDPOINT=
AZURE_API_KEY=

# Optional: legacy /api/chatbot route
GEMINI_API_KEY=

EXPIRY_CRON=0 9 * * *
EXPIRY_CLEANUP_ENABLED=false

# Optional: content moderation, posts publish unmoderated while disabled
JEV_ENABLED=false
JEV_API_KEY=
JEV_BASE_URL=https://ai-gateway.vercel.sh
JEV_MODEL=typesafe-ai/jev
JEV_TIMEOUT_MS=2000
